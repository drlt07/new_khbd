DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lesson_planner?schema=public"
# Chuỗi ngẫu nhiên >= 32 ký tự, dùng để ký phiên đăng nhập (JWT)
AUTH_SECRET=""
# AI provider: "mock" | "openai". Khi để mock, mọi kết quả AI được đánh dấu là MÔ PHỎNG.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
UPLOAD_DIR="./storage/uploads"
# Hiện chỉ hỗ trợ "local"; object storage (S3/R2) sẽ được thêm khi triển khai
STORAGE_DRIVER="local"
