// Chia nhóm học sinh — schema tối giản.
// Pha 1: học sinh + đặc trưng + bảng điểm -> bộ nhóm do GV định nghĩa. Pha 2: KHBD giao nhiệm vụ theo từng nhóm.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classes   Class[]
  resources LearningResource[]
  logs      ActivityLog[]
}

model Class {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  schoolYear String
  isSample   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  students    Student[]
  groupings   GroupingSession[]
  scoreSheets ScoreSheet[]
  logs        ActivityLog[]

  @@unique([ownerId, name, schoolYear])
}

model Student {
  id          String   @id @default(cuid())
  classId     String
  studentCode String?
  fullName    String
  gender      String?
  notes       String?
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  traits      StudentTrait[]
  memberships GroupMember[]
  scores      StudentScore[]

  @@unique([classId, studentCode])
  @@index([classId])
}

enum TraitKind {
  INTEREST // Sở thích
  STRENGTH // Thế mạnh
  NEED // Cần hỗ trợ
}

/// Một đặc điểm ngắn của học sinh, ví dụ: STRENGTH "Thuyết trình"
model StudentTrait {
  id        String    @id @default(cuid())
  studentId String
  kind      TraitKind
  label     String
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, kind, label])
}

/// Một lần tải bảng điểm lên (Pha 1). Điểm chỉ dùng khi GV đặt khoảng điểm cho nhóm.
model ScoreSheet {
  id        String   @id @default(cuid())
  classId   String
  subject   String // môn học của bảng điểm
  fileName  String
  createdAt DateTime @default(now())

  class     Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  columns   ScoreColumn[]
  groupings GroupingSession[]
}

/// Một cột điểm trong bảng (TX1, Giữa kỳ, Cuối kỳ...)
model ScoreColumn {
  id        String @id @default(cuid())
  sheetId   String
  label     String
  weight    Int    @default(1) // hệ số: TX 1, GK 2, CK 3
  sortOrder Int    @default(0)

  sheet  ScoreSheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  scores StudentScore[]
}

model StudentScore {
  id        String @id @default(cuid())
  columnId  String
  studentId String
  value     Float

  column  ScoreColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([columnId, studentId])
}

// ─────────────── PHA 1 — Phiên phân nhóm (có phiên bản) & Hồ sơ nhóm ───────────────

enum SessionStatus {
  DRAFT // đang thực hiện (bước 1–4)
  CONFIRMED // GV đã duyệt — là nguồn dữ liệu cho Pha 2
  SUPERSEDED // đã có phiên bản mới được duyệt thay thế
}

/// Một phiên phân nhóm. Các phiên bản của cùng một bộ nhóm chung lineageId.
/// Sửa một phiên đã duyệt = tạo phiên bản mới; phiên cũ được giữ để KHBD cũ vẫn truy vết được.
model GroupingSession {
  id           String        @id @default(cuid())
  classId      String
  lineageId    String
  version      Int           @default(1)
  title        String
  subject      String?
  status       SessionStatus @default(DRAFT)
  step         Int           @default(1) // bước xa nhất đã tới trong stepper (1–4)
  scoreSheetId String?
  balanceSizes Boolean       @default(false)
  engine       String? // bộ máy đã phân nhóm: "rules-v1" | "claude:<model>"
  analyzedAt   DateTime?
  confirmedAt  DateTime?
  isSample     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  scoreSheet  ScoreSheet?    @relation(fields: [scoreSheetId], references: [id], onDelete: SetNull)
  groups      GroupProfile[]
  lessonPlans LessonPlan[]

  @@index([classId, lineageId])
  @@map("Grouping")
}

/// Hồ sơ nhóm học tập: tiêu chí GV đặt + đặc trưng tổng hợp sau khi duyệt.
model GroupProfile {
  id           String   @id @default(cuid())
  sessionId    String   @map("groupingId")
  slotKey      String // giữ nguyên qua các phiên bản để KHBD ánh xạ nhiệm vụ sang nhóm mới
  name         String
  description  String?  @map("profile") // GV mô tả mong muốn về nhóm
  keywords     String[] @default([])
  scoreMin     Float?
  scoreMax     Float?
  forSupport   Boolean  @default(false)
  maxSize      Int?
  criteria     Json? // tiêu chí hệ thống hiểu được từ mô tả + tiêu chí GV đặt (dùng khi phân nhóm)
  // Hồ sơ tổng hợp (Pha 1 bước 4)
  competency   String? // đặc trưng năng lực
  strengths    String[] @default([])
  difficulties String[] @default([])
  needs        String? // nhu cầu học tập
  supportGoal  String? // mục tiêu hỗ trợ
  avgScore     Float?
  sortOrder    Int      @default(0)

  session GroupingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  members GroupMember[]
  tasks   GroupTask[]

  @@map("Group")
}

model GroupMember {
  id        String  @id @default(cuid())
  groupId   String
  studentId String
  reason    String?
  fit       String? // good | partial | none | manual

  group   GroupProfile @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
}

// ─────────────── PHA 2 — KHBD phân hóa theo nhóm ───────────────

enum LessonStatus {
  DRAFT
  REVIEW
  DONE
}

model LessonPlan {
  id              String       @id @default(cuid())
  sessionId       String       @map("groupingId") // phiên bản hồ sơ nhóm đang dùng
  subject         String
  title           String
  periods         Int          @default(1)
  requirements    String?
  content         String? // nội dung bài học
  methods         String? // phương pháp, kĩ thuật dạy học
  knowledgeGoals  String?
  competencyGoals String?
  qualityGoals    String?
  materials       String?
  assessment      String?
  engine          String?
  status          LessonStatus @default(DRAFT)
  isSample        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  session    GroupingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activities LessonActivity[]
}

enum ActivityPhase {
  OPENING
  KNOWLEDGE
  PRACTICE
  APPLICATION
}

model LessonActivity {
  id           String        @id @default(cuid())
  lessonPlanId String
  phase        ActivityPhase
  title        String
  minutes      Int?
  goal         String?
  content      String?
  product      String?
  organization String?
  byGroup      Boolean       @default(true)
  sortOrder    Int           @default(0)

  lessonPlan LessonPlan  @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  tasks      GroupTask[]
}

/// Nhiệm vụ của một nhóm trong một hoạt động
model GroupTask {
  id         String  @id @default(cuid())
  activityId String
  groupId    String
  task       String
  product    String?
  support    String?
  materials  String? // học liệu
  challenge  String? // mức độ thử thách
  assessment String? // đánh giá theo nhóm

  activity LessonActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  group    GroupProfile   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([activityId, groupId])
}

// ─────────────── LIBRARY & lịch sử ───────────────

model LearningResource {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  type        String // Phiếu học tập, Video, Bài đọc, Trình chiếu, Khác
  subject     String?
  url         String?
  description String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

/// Lịch sử hoạt động (kiểu Notion): ai làm gì, lúc nào, ở lớp nào
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  classId   String?
  action    String
  message   String
  href      String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
