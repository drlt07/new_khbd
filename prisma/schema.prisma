// Chia nhóm học sinh — schema tối giản.
// Nguyên tắc: không lưu xếp loại học lực; nhóm gắn với từng lần chia (bài học), không gắn cứng vào học sinh.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classes Class[]
}

model Class {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  schoolYear String
  isSample   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  students  Student[]
  groupings Grouping[]

  @@unique([ownerId, name, schoolYear])
}

model Student {
  id          String   @id @default(cuid())
  classId     String
  studentCode String?
  fullName    String
  gender      String?
  notes       String?
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  traits       StudentTrait[]
  memberships  GroupMember[]

  @@unique([classId, studentCode])
  @@index([classId])
}

enum TraitKind {
  INTEREST // Sở thích
  STRENGTH // Thế mạnh
  NEED     // Cần hỗ trợ
}

/// Một đặc điểm ngắn của học sinh, ví dụ: STRENGTH "Thuyết trình"
model StudentTrait {
  id        String    @id @default(cuid())
  studentId String
  kind      TraitKind
  label     String
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, kind, label])
}

enum GroupingMethod {
  MIXED    // Đa dạng: mỗi nhóm có nhiều thế mạnh khác nhau, HS cần hỗ trợ được rải đều
  INTEREST // Theo sở thích chung
  RANDOM   // Ngẫu nhiên, sĩ số cân bằng
}

/// Một lần chia nhóm cho một bài học / hoạt động
model Grouping {
  id         String         @id @default(cuid())
  classId    String
  title      String // tên bài học / hoạt động
  method     GroupingMethod
  isSample   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  class  Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  groups Group[]
}

model Group {
  id         String @id @default(cuid())
  groupingId String
  name       String
  task       String? // nhiệm vụ / vai trò của nhóm
  sortOrder  Int    @default(0)

  grouping Grouping      @relation(fields: [groupingId], references: [id], onDelete: Cascade)
  members  GroupMember[]
}

model GroupMember {
  id        String  @id @default(cuid())
  groupId   String
  studentId String
  reason    String? // lý do xếp vào nhóm (từ hồ sơ)

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
}
